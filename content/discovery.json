  "closed.vccv": {
    "panels": [
      {
        "art": "ui-sq/plank",
        "text": "Two different consonants sit in the middle: nap-kin. Split between them.",
        "voice": "v.discovery.closed-vccv.1",
        "examples": [
          "napkin",
          "picnic",
          "basket",
          "helmet"
        ],
        "try": []
      },
      {
        "art": "ui-sq/plank",
        "text": "Cover the second part and read the first. Then read the second. Then blend.",
        "voice": "v.discovery.closed-vccv.2",
        "examples": [
          "magnet",
          "velvet",
          "insect",
          "plastic"
        ],
        "try": []
      },
      {
        "art": "ui-sq/clan-closed",
        "text": "Both parts are {closed} syllables, so both vowels are short.",
        "voice": "v.discovery.closed-vccv.3",
        "examples": [
          "trumpet",
          "problem",
          "public",
          "dentist"
        ],
        "try": [

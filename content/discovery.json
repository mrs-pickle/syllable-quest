{
  "closed.review": {
    "panels": [
      {
        "art": "ui-sq/clan-closed",
        "text": "A {closed} syllable has one vowel and ends in a consonant. The consonant closes the door, so the vowel is short.",
        "voice": "v.discovery.closed-review.1",
        "examples": [
          "cat",
          "hop",
          "sit",
          "bug"
        ],
        "try": []
      },
      {
        "art": "mouth/sh",
        "text": "Two letters can make one sound. S and h say sh. C and h say ch.",
        "voice": "v.discovery.closed-review.2",
        "examples": [
          "ship",
          "shop",
          "chip",
          "chin"
        ],
        "try": []
      },
      {
        "art": "mouth/th",
        "text": "T and h say th. Put your tongue between your teeth and push the air out.",
        "voice": "v.discovery.closed-review.3",
        "examples": [
          "path",
          "math",
          "moth",
          "bath"
        ],
        "try": []
      },
      {
        "art": "mouth/ng",
        "text": "N and g say ng at the end of a word. N and k say nk. Listen for the sound in your nose.",
        "voice": "v.discovery.closed-review.4",
        "examples": [
          "sing",
          "king",
          "long",
          "sink",
          "pink",
          "bank"
        ],
        "try": []
      },
      {
        "art": "ui-sq/tile",
        "text": "After a short vowel, a word often ends in ck, ff, ll, ss, zz, tch or dge. These keep the vowel short.",
        "voice": "v.discovery.closed-review.5",
        "examples": [
          "duck",
          "puff",
          "bell",
          "miss",
          "buzz",
          "catch",
          "badge",
          "ball"
        ],
        "try": [
          "fix"
        ]
      }
    ],
    "try": [
      "chip",
      "catch"
    ],
    "recap": "v.discovery.closed-review.recap"
  },
  "closed.endings": {
    "panels": [
      {
        "art": "ui-sq/plank",
        "text": "After p, k, s, sh or ch, the ending -ed says t.",
        "voice": "v.discovery.closed-endings.1",
        "examples": [
          "jumped",
          "packed",
          "wished",
          "helped",
          "missed",
          "kicked"
        ],
        "try": []
      },
      {
        "art": "ui-sq/plank",
        "text": "After b, g, m, n or l, the ending -ed says d.",
        "voice": "v.discovery.closed-endings.2",
        "examples": [
          "hugged",
          "filled",
          "planned",
          "grinned",
          "begged",
          "spilled"
        ],
        "try": []
      },
      {
        "art": "ui-sq/plank",
        "text": "After t or d, the ending -ed adds a whole new part: hunt-ed, land-ed.",
        "voice": "v.discovery.closed-endings.3",
        "examples": [
          "hunted",
          "landed",
          "lifted",
          "melted",
          "rested",
          "tested"
        ],
        "try": []
      },
      {
        "art": "ui-sq/tile",
        "text": "The ending -s says s after p, t or k, and z after most other sounds.",
        "voice": "v.discovery.closed-endings.4",
        "examples": [
          "cats",
          "cups",
          "maps",
          "dogs",
          "kids",
          "pigs",
          "hens",
          "rugs"
        ],
        "try": []
      },
      {
        "art": "ui-sq/tile",
        "text": "After s, x, sh or ch, the ending -es adds a part: wish-es, box-es.",
        "voice": "v.discovery.closed-endings.5",
        "examples": [
          "wishes",
          "boxes",
          "benches",
          "catches",
          "misses",
          "dishes"
        ],
        "try": []
      }
    ],
    "try": [
      "hunted",
      "dishes"
    ],
    "recap": "v.discovery.closed-endings.recap"
  },
  "closed.compound": {
